{
  "name": "autoheal",
  "version": "1.3.0",
  "license": "MIT",
  "description": "Heals failed Docker containers across a home lab: per-host runners, one control plane, a local model that only picks from a fixed menu.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "test/fixtures/tls/generate.sh && NODE_EXTRA_CA_CERTS=test/fixtures/tls/trusted-ca.pem vitest run",
    "test:e2e": "playwright test",
    "prettier-format": "prettier . --write",
    "prettier-check": "prettier . --check",
    "test:smoke": "test/fixtures/tls/generate.sh && test/smoke/run-smoke.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "age-encryption": "^0.3.1",
    "bcrypt-pbkdf": "1.0.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ssh2": "1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
